# TeleDoc Environment Configuration

# Telegram Bot Token from @BotFather
# Optional for local demo mode, required for live Telegram bot operation
TELEGRAM_BOT_TOKEN=

# Server network settings
PORT=8080
HOST=0.0.0.0

# Public URL of the Mini App (used in Telegram inline buttons)
# Defaults to http://localhost:8080 when running locally
APP_URL=http://localhost:8080

# Demo mode enables bundled sample documents and bypasses bot token validation
DEMO_MODE=true

# Temporary storage directory for uploaded images and compiled PDFs
STORAGE_DIR=./storage
