{
  "name": "teledoc-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram Mini App document scanner with perspective correction and OCR",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:all": "concurrently -n \"web,server\" -c \"blue,green\" \"npm run dev --workspace=web\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "test": "npm run test --workspace=web && npm run test --workspace=server",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^9.1.2",
    "gifenc": "^1.0.3",
    "puppeteer": "^25.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "telegram-mini-app",
    "document-scanner",
    "perspective-correction",
    "ocr",
    "tesseract",
    "pdf-lib"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT"
}
